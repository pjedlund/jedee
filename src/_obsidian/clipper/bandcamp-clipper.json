{
	"schemaVersion": "0.1.0",
	"name": "Bandcamp",
	"behavior": "create",
	"noteContentFormat": "{{schema:@MusicAlbum:track.itemListElement|map:item => ({name: item.item.name, url: item.item.mainEntityOfPage})|template:\"- [${name}](${url})\\n\"}}",
	"properties": [
		{
			"name": "title",
			"value": "{{schema:@MusicAlbum:name}}",
			"type": "text"
		},
		{
			"name": "draft",
			"value": "true",
			"type": "checkbox"
		},
		{
			"name": "date",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "artist",
			"value": "{{schema:@MusicAlbum:byArtist.name|wikilink}}",
			"type": "text"
		},
		{
			"name": "album",
			"value": "{{schema:@MusicAlbum:name}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "cover",
			"value": "{{schema:@MusicAlbum:image}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "genre",
			"value": "{{schema:@MusicAlbum:keywords|slice:0,-1|wikilink}}",
			"type": "multitext"
		},
		{
			"name": "year",
			"value": "{{schema:@MusicAlbum:datePublished|date:\"YYYY\"}}",
			"type": "number"
		},
		{
			"name": "favoriteTrack",
			"value": "",
			"type": "text"
		},
		{
			"name": "favoriteTrackUrl",
			"value": "",
			"type": "text"
		},
		{
			"name": "odesliUrl",
			"value": "",
			"type": "text"
		},
		{
			"name": "youtubeSlug",
			"value": "",
			"type": "text"
		},
		{
			"name": "note",
			"value": "",
			"type": "text"
		}
	],
	"triggers": [
		"/bandcamp\\.com/album/"
	],
	"noteNameFormat": "{{schema:@MusicAlbum:name|safe_name}}",
	"path": "posts/jams/"
}
