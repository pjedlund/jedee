{
	"schemaVersion": "0.1.0",
	"name": "Raw (wiki source)",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "sourceUrl",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "sourceName",
			"value": "{{site}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\", \"}}",
			"type": "multitext"
		},
		{
			"name": "clipped",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{meta:property:article:published_time|slice:0,10}}",
			"type": "text"
		},
		{
			"name": "note",
			"value": "",
			"type": "text"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title|safe_name}}",
	"path": "_raw/"
}
