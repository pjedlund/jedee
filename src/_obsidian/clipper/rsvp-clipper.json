{
	"schemaVersion": "0.1.0",
	"name": "RSVP",
	"behavior": "create",
	"noteContentFormat": "",
	"properties": [
		{
			"name": "title",
			"value": "{{schema:@Event:name}}",
			"type": "text"
		},
		{
			"name": "draft",
			"value": "true",
			"type": "checkbox"
		},
		{
			"name": "date",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "rsvp",
			"value": "",
			"type": "text"
		},
		{
			"name": "inReplyTo",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "sourceName",
			"value": "{{meta:property:og:site_name}}",
			"type": "text"
		},
		{
			"name": "sourceUrl",
			"value": "{{url|split:\"/\"|slice:0,3|join:\"/\"}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "",
			"type": "multitext"
		}
	],
	"triggers": [
		"schema:@Event"
	],
	"noteNameFormat": "{{schema:@Event:name|safe_name}}",
	"path": "posts/rsvps/"
}
