{
  "$type": "typography",
  "$description": "Typography composite tokens — bundled type styles that apply font family, weight, size, and line height in one token. Mirrors the type styles in src/assets/css/global/base/global-styles.css. Inner values reference atomic tokens from fonts.json / textWeights.json / textSizes.json / textLeading.json so any change cascades. DESIGN-FILE ONLY: tailwind.config.js does not read this, so nothing here reaches the CSS; build-design-md.js and the frozen Penpot export read it. letterSpacing holds the px values matched by eye for Penpot in 2026-08 (the CSS uses ch); npm run figcraft:tokens skips them, because the FigCraft file uses the site's measured tracking instead.",
  "letterSpacing": {
    "wide": {
      "$value": "2.23",
      "$description": "--tracking-wide (0.16ch) at the 28px body size, e.g. the event card's month. A design file has no ch, so each size gets its own px value: 0.16 × 0.497 × size (1ch = 0.497em in Source Sans 3)."
    },
    "label": {
      "$value": "1.27",
      "$description": "--tracking-wide at 16px (step-min-2): capital labels — breadcrumb, Menu, footer, tags, small buttons."
    },
    "table": {
      "$value": "1.75",
      "$description": "--tracking-wide at 22px (step-min-1): table column heads."
    }
  },
  "styles": {
    "body": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-0}",
      "lineHeight": "{font.lineHeight.standard}"
    },
    "heading.1": {
      "fontFamily": "{font.family.display}",
      "fontWeight": "{font.weight.bold}",
      "fontSize": "{font.size.step-6}",
      "lineHeight": "{font.lineHeight.extrafine}",
      "letterSpacing": "-5"
    },
    "heading.2": {
      "fontFamily": "{font.family.display}",
      "fontWeight": "{font.weight.bold}",
      "fontSize": "{font.size.step-4}",
      "lineHeight": "{font.lineHeight.fine}",
      "letterSpacing": "-3.2"
    },
    "heading.3": {
      "fontFamily": "{font.family.display}",
      "fontWeight": "{font.weight.bold}",
      "fontSize": "{font.size.step-2}",
      "lineHeight": "{font.lineHeight.fine}",
      "letterSpacing": "-2.1"
    },
    "blockquote": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-2}",
      "lineHeight": "{font.lineHeight.standard}"
    },
    "citation": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-1}",
      "lineHeight": "{font.lineHeight.standard}"
    },
    "caption": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-min-1}",
      "lineHeight": "{font.lineHeight.standard}"
    },
    "intro": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-1}",
      "lineHeight": "{font.lineHeight.standard}",
      "letterSpacing": "-0.5"
    },
    "label": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.bold}",
      "fontSize": "{font.size.step-min-2}",
      "lineHeight": "{font.lineHeight.flat}",
      "letterSpacing": "{font.letterSpacing.label}",
      "textCase": "uppercase"
    },
    "table.header": {
      "fontFamily": "{font.family.base}",
      "fontWeight": "{font.weight.regular}",
      "fontSize": "{font.size.step-min-1}",
      "lineHeight": "{font.lineHeight.standard}",
      "letterSpacing": "{font.letterSpacing.table}"
    }
  }
}
