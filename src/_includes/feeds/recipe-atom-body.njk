{#-
  Recipe-aware Atom feed body (spec §8). Identical to atom-body.njk except it
  renders the frontmatter recipe — ingredients/instructions, yield/time, and an
  optional dish photo — ahead of post.content. The shared atom-body emits ONLY
  post.content, so a Recipe (whose substance lives in frontmatter, not the body)
  would otherwise feed with the whole recipe missing. Set the same vars as
  atom-body.njk before including:
    feedCollection, feedTitle, feedDescription, feedSelfUrl
-#}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ meta.lang or page.lang }}" xml:base="{{ meta.url }}/">
  <title>{{ feedTitle }}</title>
  <subtitle>{{ feedDescription }}</subtitle>
  <link href="{{ feedSelfUrl | htmlBaseUrl(meta.url) }}" rel="self" />
  <link href="{{ meta.url | addPathPrefixToFullUrl }}" />
  <updated>{{ feedCollection | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ meta.url | addPathPrefixToFullUrl }}</id>
  <author>
    <name>{{ meta.author.name }}</name>
  </author>
  {%- for post in feedCollection | reverse -%}
  {%- set absolutePostUrl = post.url | absoluteUrl(meta.url) -%}
  {%- set r = post.data.recipe -%}
  {# Build the recipe block as a sync string (async shortcodes render empty
     inside {% set %} capture — Photo's lesson). A plain <img> lets the dish
     photo ride renderTransforms, which optimizes it and rewrites every URL to
     absolute — the same path body images take into the other feeds. The
     ingredients/instructions are plain strings, so no async is needed. #}
  {%- set recipeHtml %}{% if r.image %}<img src="{{ r.image | replace('./src', '') }}" alt="{{ post.data.title }}">{% endif %}<dl>{% if r.yield %}<dt>Yields</dt><dd>{{ r.yield }}</dd>{% endif %}{% if r.totalTime %}<dt>Total time</dt><dd>{{ r.totalTime | formatDuration }}</dd>{% endif %}</dl><h2>Ingredients</h2><ul>{% for i in r.ingredients %}<li>{{ i }}</li>{% endfor %}</ul><h2>Instructions</h2><ol>{% for s in r.instructions %}<li>{{ s }}</li>{% endfor %}</ol>{% endset -%}
    <entry>
      <title>{{ post.data.title }}</title>
      <link href="{{ absolutePostUrl }}" />
      <updated>{{ post.date | dateToRfc3339 }}</updated>
      <id>{{ absolutePostUrl }}</id>
      <content type="html">
        {{ (recipeHtml ~ post.content) | renderTransforms(post.data.page, meta.url) }}
      </content>
    </entry>
  {%- endfor -%}
</feed>
