{#-
  Recipe-aware JSON Feed body (jsonfeed.org/version/1.1, spec §8). Identical to
  json-body.njk except it prepends the frontmatter recipe (ingredients/
  instructions, yield/time, optional dish photo) to content_html — see
  recipe-atom-body.njk for the why. Set the same vars as json-body.njk before
  including.
-#}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "{{ feedTitle }}",
  "language": "{{ meta.lang or page.lang }}",
  "home_page_url": "{{ meta.url | addPathPrefixToFullUrl }}",
  "feed_url": "{{ feedSelfUrl | htmlBaseUrl(meta.url) }}",
  "description": "{{ feedDescription }}",
  "authors": [
    {
      "name": "{{ meta.author.name }}"
    }
  ],
  "items": [
    {%- for post in feedCollection | reverse -%}
    {%- set absolutePostUrl = post.url | absoluteUrl(meta.url) -%}
    {%- set r = post.data.recipe -%}
    {# Sync recipe block — see recipe-atom-body.njk for why not the shortcode. #}
    {%- set recipeHtml %}{% if r.image %}<img src="{{ r.image | replace('./src', '') }}" alt="{{ post.data.title }}">{% endif %}<dl>{% if r.yield %}<dt>Yields</dt><dd>{{ r.yield }}</dd>{% endif %}{% if r.totalTime %}<dt>Total time</dt><dd>{{ r.totalTime | formatDuration }}</dd>{% endif %}</dl><h2>Ingredients</h2><ul>{% for i in r.ingredients %}<li>{{ i }}</li>{% endfor %}</ul><h2>Instructions</h2><ol>{% for s in r.instructions %}<li>{{ s }}</li>{% endfor %}</ol>{% endset -%}
    {
      "id": "{{ absolutePostUrl }}",
      "url": "{{ absolutePostUrl }}",
      "title": {{ post.data.title | dump | safe }},
      "content_html": {{ (recipeHtml ~ post.content) | renderTransforms(post.data.page, meta.url) | dump | safe }},
      "date_published": "{{ post.date | dateToRfc3339 }}"
    }
    {% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
