{# Shared archive card for the light "response" post types (bookmark, reply, rsvp, like, repost). Unlike card-note.njk it assumes no title: the headline is a verb + a link to the external target, carrying the µf2 property class. The date links to the response's own page (timestamp-as-permalink). Not `clickable` — two distinct destinations (off-site target + on-site page) would both claim the stretched-link ::after and conflict. #}

{% set headingLevel = headingLevel | default("h2") %}
{% set cat = item.data.category %}

{% set verbs = { "bookmark": "Bookmarked", "reply": "In reply to", "rsvp": "RSVP to", "like": "Liked", "repost": "Reposted" } %}
{% set mf2 = { "bookmark": "u-bookmark-of", "reply": "u-in-reply-to", "rsvp": "u-in-reply-to", "like": "u-like-of", "repost": "u-repost-of" } %}
{% set fields = { "bookmark": "bookmarkOf", "reply": "inReplyTo", "rsvp": "inReplyTo", "like": "likeOf", "repost": "repostOf" } %}
{% set target = item.data[fields[cat]] %}

<custom-card>
  <{{ headingLevel }} slot="headline" class="text-step-1">
    {%- if cat == "rsvp" and item.data.rsvp -%}
      RSVP <em>{{ item.data.rsvp }}</em> to
    {%- else -%}
      {{ verbs[cat] }}
    {%- endif %}
    {% if target %}<a class="{{ mf2[cat] }}" href="{{ target }}">{{ target }}</a>{% endif %}
  </{{ headingLevel }}>
  <span slot="date">
    {%- if item.data.draft -%}<span class="button" data-small-button data-button-variant='tertiary'>draft</span> {% endif -%}
    <a href="{{ item.url | url }}">{% set definedDate = item.date %}{% include "partials/date.njk" %}</a>
  </span>
  {% if item.data.description %}
    <div slot="content" webc:nokeep>{{ item.data.description | markdownFormat | safe }}</div>
  {% endif %}
</custom-card>

{% css "local" %}
  {% include "css/custom-card.css" %}
{% endcss %}
