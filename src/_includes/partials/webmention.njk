{# One received webmention as an h-cite card. #}
{# ⚠ No `dt-published` on the date: that property belongs to this site's own posts. ⚠ Never `| safe` on content.text: a remote mention's HTML is untrusted. #}

<article id="webmention-{{ webmention['wm-id'] }}" class="webmention h-cite | flow">
  <div class="cluster">
    {% if webmention.author and webmention.author.name %}
      {# h-card's url is implied from this <a href>, so no explicit u-url here — that keeps the h-cite's only u-url the comment permalink (the hidden <data> below), not the author's profile. #}
      <a
        class="author p-author h-card"
        href="{{ webmention.author.url or webmention.url }}"
        rel="noreferrer"
      >
        <img
          eleventy:ignore
          class="u-photo"
          src="{{ webmention.author.photo or (meta.webmentions.fallbackAvatar | url) }}"
          alt=""
          width="48"
          height="48"
          loading="lazy"
        />
        <strong class="p-name">{{ webmention.author.name }}</strong>
      </a>
    {% else %}
      <strong class="author">{{ words.anonymous }}</strong>
    {% endif %}

    {% if webmention['wm-received'] %}
      <span class="separator" aria-hidden="true">·</span>
      {% if webmention.url %}
        {# The date is the permalink to the comment itself. `.no-indicator` keeps the outbound ↗ on the author name only, not both. #}
        <a class="no-indicator" href="{{ webmention.url }}" rel="noreferrer">
          <time datetime="{{ webmention['wm-received'] | toIsoString }}">
            {{ webmention['wm-received'] | formatDate('D MMM YYYY') }}
          </time>
        </a>
      {% else %}
        <time datetime="{{ webmention['wm-received'] | toIsoString }}">
          {{ webmention['wm-received'] | formatDate('D MMM YYYY') }}
        </time>
      {% endif %}
    {% endif %}
  </div>

  <div class="p-content">
    {{ webmention.content.text | truncate }}
  </div>

  {% if webmention.url %}<data class="u-url" value="{{ webmention.url }}"></data>{% endif %}
</article>
