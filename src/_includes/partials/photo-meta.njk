{# Photo metadata block: capture facts, downloads, the public-domain line and a collapsible scan block. Expects:
  - `photoExif`        build-time, render-safe (src/_config/utils/exif.js)
  - `photo.format` / `photo.exposure` / `photo.film` / `photo.development`   authored capture facts
  - `photo.downloads`  the FIRST entry is the full-size raster, and drives the lightbox and the Resolution row
#}
{% set ex = photoExif %}

{# First download is the full-size raster (JPEG) — drives Resolution + the lightbox. #}
{% set raster = false %}
{% if photo.downloads %}{% set raster = photo.downloads[0] %}{% endif %}

{# The Place row links to OpenStreetMap whenever there's GPS. #}
{% if ex or photo.downloads %}
<section class="media-meta | flow" aria-label="{{ words.photographDetails }}">

  {% if ex %}
  <dl>
    {% if ex.camera %}<dt>{{ words.camera }}</dt><dd>{{ ex.camera }}</dd>{% endif %}
    {% if photo.format %}<dt>{{ words.format }}</dt><dd>{{ photo.format }}</dd>{% endif %}
    {% if photo.exposure %}<dt>{{ words.exposure }}</dt><dd>{{ photo.exposure }}</dd>{% endif %}
    {% if photo.film %}<dt>{{ words.film }}</dt><dd>{{ photo.film }}</dd>{% endif %}
    {% if photo.development %}<dt>{{ words.development }}</dt><dd>{{ photo.development }}</dd>{% endif %}
    {% if ex.dateTaken %}<dt>{{ words.taken }}</dt><dd>{{ ex.dateTaken }}</dd>{% endif %}
    {% if ex.place %}<dt>{{ words.place }}</dt>
      <dd class="p-location h-adr">
        {%- if ex.gps %}<a href="https://www.openstreetmap.org/?mlat={{ ex.gps.lat }}&mlon={{ ex.gps.lon }}#map={{ photo.mapZoom or 13 }}/{{ ex.gps.lat }}/{{ ex.gps.lon }}" target="_blank" rel="noopener">{% endif -%}
        {%- if ex.place.city %}<span class="p-locality">{{ ex.place.city }}</span>{% endif -%}
        {%- if ex.place.region %}{% if ex.place.city %}, {% endif %}<span class="p-region">{{ ex.place.region }}</span>{% endif -%}
        {%- if ex.place.country %}{% if ex.place.city or ex.place.region %}, {% endif %}<span class="p-country-name">{{ ex.place.country }}</span>{% endif -%}
        {%- if ex.gps %}</a>{% endif -%}
      </dd>
    {% endif %}
  </dl>
  {% endif %}

  {% if photo.downloads %}
  <ul class="media-downloads | cluster" role="list">
    {% for dl in photo.downloads %}
    <li>
      <a class="button" href="{{ dl.url }}" rel="enclosure" download>
        {{ dl.label }}
      </a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  <p class="text-step-min-1 media-license">
    <a rel="license" href="https://creativecommons.org/publicdomain/zero/1.0/">{{ words.publicDomain }}</a> {{ words.downloadFree | safe }}
  </p>

  {% if ex and (ex.aperture or ex.exposure or ex.iso or ex.focalLength or ex.scanLens or ex.software or ex.gps or ex.dateDigitized or photo.scanner or (raster and raster.width and raster.height)) %}
  <details class="photo-tech">
    <summary>{{ words.scanTechnicalData }}</summary>
    <dl>
      {% if raster and raster.width and raster.height %}<dt>{{ words.resolution }}</dt><dd>{{ raster.width }}&times;{{ raster.height }} ({{ (raster.width * raster.height / 1000000) | round(1) }} MP)</dd>{% endif %}
      {% if ex.aperture %}<dt>{{ words.scanAperture }}</dt><dd>{{ ex.aperture }}</dd>{% endif %}
      {% if ex.exposure %}<dt>{{ words.scanShutter }}</dt><dd>{{ ex.exposure }}</dd>{% endif %}
      {% if ex.iso %}<dt>ISO</dt><dd>{{ ex.iso }}</dd>{% endif %}
      {% if ex.focalLength %}<dt>{{ words.scanFocalLength }}</dt><dd>{{ ex.focalLength }}{% if ex.focalLength35 %} ({{ ex.focalLength35 }} eq.){% endif %}</dd>{% endif %}
      {% if photo.scanner %}<dt>{{ words.scanner }}</dt><dd>{{ photo.scanner }}</dd>{% endif %}
      {% if ex.scanLens %}<dt>{{ words.scanLens }}</dt><dd>{{ ex.scanLens }}</dd>{% endif %}
      {% if ex.software %}<dt>{{ words.software }}</dt><dd>{{ ex.software }}</dd>{% endif %}
      {% if ex.gps %}<dt>{{ words.coordinates }}</dt>
        <dd class="h-geo"><data class="p-latitude" value="{{ ex.gps.lat }}">{{ ex.gps.lat | round(5) }}</data>, <data class="p-longitude" value="{{ ex.gps.lon }}">{{ ex.gps.lon | round(5) }}</data></dd>
      {% endif %}
      {% if ex.dateDigitized %}<dt>{{ words.digitized }}</dt><dd>{{ ex.dateDigitized }}</dd>{% endif %}
    </dl>
  </details>
  {% endif %}

</section>
{% endif %}

{% css "local" %}
  {% include "css/media-meta.css" %}
{% endcss %}
