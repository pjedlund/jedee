{# The meta line's dates, linked to GitHub: "[icon] 6 Sep 2026, updated 2 Nov 2026" — the date opens the file as first written (an imported post, with no such version, opens the file as it is now), the update date its full history. Expects `date`, `revision` (gitRevision with the date, may be null), `mf2` (true inside an h-entry) and optionally `hideUpdate`. #}
{%- set showRepo = revision and meta.switches.dateLinks %}
{%- set showEdit = showRepo and not hideUpdate and (revision.date | formatDate('YYYY-MM-DD')) != (date | formatDate('YYYY-MM-DD')) %}
<span class="meta-item">
  {%- if showRepo -%}
    {% svg 'platform/github', '', 'meta-icon' %}<span class="visually-hidden">{{ words.onGitHub }} </span>
  {%- endif -%}
  {%- set publishedTime -%}<time{% if mf2 %} class="dt-published"{% endif %} datetime="{{ date | toIsoString }}">{{ date | formatDate(words.dateMeta) }}</time>{%- endset -%}
  {%- if showRepo -%}
    <a href="{{ settings.repos.site }}/{{ ('blob/' + revision.first.hash) if revision.first else 'blob/main' }}/{{ revision.path }}">{{ publishedTime | safe }}</a>
  {%- else -%}
    {{ publishedTime | safe }}
  {%- endif -%}
  {%- if showEdit -%}
    , {{ words.updated }} <a href="{{ settings.repos.site }}/commits/main/{{ revision.path }}"><time{% if mf2 %} class="dt-updated"{% endif %} datetime="{{ revision.date | toIsoString }}">{{ revision.date | formatDate(words.dateMeta) }}</time></a>
  {%- endif -%}
</span>
