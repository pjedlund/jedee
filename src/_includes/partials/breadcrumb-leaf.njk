{# The visible label of the final crumb; default = the page title. `breadcrumbs[].label` (aria, JSON-LD) stays the raw title. Per type:
   - jam                → "Song by Artist", artist un-wikilinked
   - watching / reading → "Title by Director/Author" (a name or a list)
   - activity           → "Orienteering: Title"
   - genre archive      → the bare genre name
   - like / bookmark / reply / repost → "Title on host", or the bare host when untitled; always the host, never sourceName; RSVP is left out because its title already names the target
   - 404                → "404: Title"
#}
{%- set linkedHost = (sourceUrl or likeOf or bookmarkOf or inReplyTo or repostOf) | hostname -%}
{%- if category == "jam" and artist -%}
  {{ title }} <span class="breadcrumb-connector">by</span> {{ artist | unwikilink }}
{%- elif (category == "watching" and director) or (category == "reading" and author) -%}
  {%- set byline = director if category == "watching" else author -%}
  {{ title }} <span class="breadcrumb-connector">by</span> {% if byline is string %}{{ byline | unwikilink }}{% else %}{{ byline | unwikilink | join(", ") }}{% endif %}
{%- elif category == "activity" and activityType -%}
  {# activityType is an English controlled term ("orienteering") — only the title may be Swedish, so lang="sv" (set by titleLang, see eleventyComputed.js) wraps the title alone. #}
  {{ activityType | capitalize }}: {% if titleLang %}<span lang="{{ titleLang }}">{{ title }}</span>{% else %}{{ title }}{% endif %}
{%- elif category == "audio" and place -%}
  {# Field recordings title the SUBJECT ("Small waves"), so the crumb composes it with where it was recorded: "Small waves at Nybrostrand". "at" carries almost every named location; a post that wants "in"/"on" (a forest, a train) sets placePreposition. `region` is deliberately left out — the leaf truncates to one line in the header, so it would be the first thing lost, and it already appears in the recording details. #}
  {{ title }} <span class="breadcrumb-connector">{{ placePreposition or "at" }}</span> {{ place }}
{%- elif category in ["like", "bookmark", "reply", "repost"] and (linkedHost) -%}
  {% if title %}{{ title }} <span class="breadcrumb-connector">on</span> {% endif %}{{ linkedHost }}
{%- elif page.url == "/404.html" -%}
  404: {{ title }}
{%- elif tag -%}
  {# Tag archive pages: show the bare tag, not the page title "Tag: <x>". #}
  {{ tag }}
{%- elif genre.name -%}
  {# Genre archive pages: the bare genre, not "Genre: <x>" — the parent crumb already says Genres. ⚠ `.name` is the guard: a jam post's own `genre` field is a string or list, and must not land here. #}
  {{ genre.name }}
{%- else -%}
  {{ title }}
{%- endif -%}
