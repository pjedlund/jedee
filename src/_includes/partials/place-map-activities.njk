{# The activity index: every activity as a table row, newest first, and above it a map that reads its dots from those rows; without JS the table is the complete index. See the wiki "The place map". #}
{# ⚠ Keep the activity link the first link in each row: the map names and links each dot from it. #}
{# ⚠ Iterate collections.activity directly, not through | located: both reverse, and together they list oldest-first. #}
{# ⚠ The empty .place-map-live box is rendered here so its aspect-ratio holds the space from first paint; the JS adopts it. #}
{# ⚠ A type with no icon in src/assets/svg/activity/ fails the build by name: add the SVG, not a fallback. #}
<place-map @place="my activities">
  {%- if collections.activity | located | length %}
    <div class="place-map-live" data-place-map-box>
      <p class="place-map-pending">Map of my activities</p>
    </div>
  {%- endif %}
  <sortable-table>
    {#- ⚠ No tabindex on this wrapper: the head buttons and row links already let a keyboard scroll it, and Safari moves focus to the nearest focusable ancestor on a click, scrolling the page and losing the click. #}
    <div class="table-wrapper" role="region" aria-labelledby="activities-caption" data-table-rows="link">
      <table data-place-list>
        <caption id="activities-caption" class="visually-hidden">Every activity</caption>
        <thead>
          <tr>
            <th scope="col" data-icon data-sort-first="ascending">Type</th>
            <th scope="col" aria-sort="descending">Date</th>
            <th scope="col">Activity</th>
            <th scope="col" data-numeric data-table-priority="3">Distance</th>
            <th scope="col" data-numeric data-table-priority="2">Time</th>
            <th scope="col" data-numeric data-table-priority="5" data-sort-first="ascending">Pace</th>
            <th scope="col" data-numeric data-table-priority="4">Heart rate</th>
          </tr>
        </thead>
        <tbody>
          {%- for post in collections.activity %}
            {%- set d = post.data %}
            {%- set day = post.date | formatDate('D MMM YYYY') %}
            {%- set p = d.activityType | pace(d.distanceKm, d.duration) %}
            {#- data-date is the marker popup's first line; it matches the visible date. -#}
            <tr data-activity="{{ d.activityType | slugify }}"{% if d.lat and d.lon %} data-lat="{{ d.lat }}" data-lon="{{ d.lon }}" data-date="{{ day }}"{% endif %}>
              {#- ⚠ No link in here: place-map reads the row's FIRST <a> as the activity. -#}
              <td class="activity-type" data-icon data-sort="{{ d.activityType }}">{% svg "activity/" + (d.activityType | slugify), "", "activity-type-icon" %}<span class="visually-hidden">{{ d.activityType | capitalize }}</span></td>
              <td data-sort="{{ post.date.getTime() }}"><time datetime="{{ post.date | toIsoString }}">{{ day }}</time></td>
              <th scope="row"><a href="{{ post.url }}"{% if d.titleLang %} lang="{{ d.titleLang }}"{% endif %}>{{ d.title }}</a></th>
              <td data-numeric data-table-priority="3" data-sort="{{ d.distanceKm }}">{{ d.distanceKm.toFixed(1) if d.distanceKm }}</td>
              <td data-numeric data-table-priority="2" data-sort="{{ d.duration }}">{{ d.duration | itunesDuration }}</td>
              <td data-numeric data-table-priority="5" data-sort="{{ (d.duration / d.distanceKm) | round if p }}">{{ p }}</td>
              <td data-numeric data-table-priority="4" data-sort="{{ d.hrAvg }}">{% if d.hrAvg %}{{ d.hrAvg }}/{{ d.hrMax or '–' }}{% endif %}</td>
            </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </sortable-table>
</place-map>
