{#
  Overview map of every located activity, grouped by activityType. The lat/lon
  frontmatter is backfilled from Eventor arena positions (script:
  _local/generated/eventor-coords.py) and, for the rest, the Strava export.

  The place list rendered here is the data source AND the no-JS / screen-reader /
  SEO path: <place-map> (place-map.js, groups mode) reads the <li data-lat data-lon>
  items on idle, builds the live map above the list, turns the group headings into
  toggles and mirrors them as chips on the map. Without JS this is a plain browsable
  list of races linking to their posts — by design, not as a degraded state.

  --dot carries each group's color as a token reference; the JS resolves it via
  computed style so the markers track the palette and theme.

  No async shortcodes here, so the interlinker {% if %}-include trap doesn't apply.
#}
{%- set located = collections.activity | located -%}
{%- if located.length -%}
  {%- set groupColors = {
    "orienteering": "var(--color-accent-orange)",
    "run": "var(--color-accent-blue)"
  } -%}
  <place-map @place="my activities">
    <div class="place-map-groups" data-place-groups>
      <ul class="place-map-places" role="list">
        {%- for type, posts in located | groupby("data.activityType") %}
          <li class="place-group" data-group="{{ type | slugify }}" style="--dot: {{ groupColors[type] or 'var(--color-accent-green)' }}">
            <h3 class="place-group-heading"><span class="place-dot" aria-hidden="true"></span>{{ type | title }} <span class="place-count">{{ posts.length }}</span></h3>
            <ul class="place-list" role="list">
              {%- for post in posts %}
                <li data-lat="{{ post.data.lat }}" data-lon="{{ post.data.lon }}">
                  <a href="{{ post.url }}">{{ post.data.title }}</a><span class="place-note">{{ post.date.getFullYear() }}</span>
                </li>
              {%- endfor %}
            </ul>
          </li>
        {%- endfor %}
      </ul>
    </div>
  </place-map>
{%- endif -%}
