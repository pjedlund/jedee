<header class="site-header wrapper">
  <a href="#main" class="skip-link">{{ meta.skipContent }}</a>

  {# Header chrome, driven by two INDEPENDENT toggles in meta.navigation:
       breadcrumb — left side: true = breadcrumb trail (◍ › Section › page), false = classic logomark + wordmark home link.
       hideNav    — main nav: true = hidden, false = shown. Revealed in `eleventy --serve` for local dev regardless (soft-launch gate).
     Right cluster order is MENU → moon: the theme toggle (sun/moon) is pinned to the far right edge, the "Menu ⌄" trigger sits just inside it, and the mega-menu drops down right-aligned under it. The .breadcrumb-bar hook (one-line / truncating row) is only needed when the breadcrumb is shown. #}
  <div class="repel ontop gutter-s{% if meta.navigation.breadcrumb %} breadcrumb-bar{% endif %}">
    {% if meta.navigation.breadcrumb %}
      {% include "partials/breadcrumb.njk" %}
    {% else %}
      <a href="/" class="logo | cluster" {{ indicateActiveHome }}>
        {% svg "misc/logo" %}

        <span class="font-base">{{ meta.siteName }}</span>
      </a>
    {% endif %}
    <div class="cluster">
      {# Soft-launch: nav hidden in production (meta.navigation.hideNav) but always revealed in local dev (`eleventy --serve`) so it stays testable. Parenthesised because Nunjucks parses `not A or B` as `not (A or B)`. #}
      {% if (not meta.navigation.hideNav) or (eleventy.env.runMode === "serve") %}
        {% include "partials/main-nav.njk" %}
      {% endif %}
      {% if features.search.enabled %}
        {% include "partials/search.njk" %}
      {% endif %}
      {% include "partials/theme-toggle.njk" %}
    </div>
  </div>
</header>
