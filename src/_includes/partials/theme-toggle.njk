{# Light/dark toggle showing the current theme; inside <is-land> so it appears only once JS can run it. The no-flash theme is set by the inline theme-toggle.js, not this button. #}
{# ⚠ No `title`: the script sets a tooltip whose wording follows the theme, while the accessible name must not change. #}
<is-land on:idle>
  <button type="button" id="theme-toggle" class="theme-toggle" data-theme-toggle aria-pressed="false" data-tooltip-align="end">
    <svg class="sun-and-moon" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
      <mask class="moon" id="theme-toggle-moon-mask">
        <rect x="0" y="0" width="100%" height="100%" fill="white" />
        <circle cx="24" cy="10" r="6" fill="black" />
      </mask>
      <circle class="sun" cx="12" cy="12" r="6" mask="url(#theme-toggle-moon-mask)" fill="currentColor" />
      <g class="sun-beams" stroke="currentColor">
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </g>
    </svg>
    <span class="visually-hidden">{{ meta.themeToggleLabel }}</span>
  </button>
</is-land>
