{# Static map for a post's location, linked to OpenStreetMap; the no-JS fallback for <place-map>. Expects mapLat, mapLon, meta.mapApiKey; optionally mapZoom, mapPlace, mapSubject (the alt text's "where this ___"). #}
{# ⚠ A plain Nunjucks <img>, never {% image %} or WebC: the image transform runs before WebC, so only this gets self-hosted. #}
{# ⚠ `src | safe` keeps the URL's literal `&` (escaped, the fetch 404s and fails the build); `eleventy:optional` turns a failed fetch into a placeholder. #}
{%- set mz = mapZoom or 13 -%}
{%- set mapSubject = mapSubject or "this was recorded" -%}
{%- set center = mapLon ~ "," ~ mapLat -%}
{# style=positron (minimal light-grey, theme-agnostic); marker = --color-accent-orange (#d0621e). #}
{%- set mapSrc = "https://maps.geoapify.com/v1/staticmap?style=positron&width=1280&height=720&center=lonlat:" ~ center ~ "&zoom=" ~ mz ~ "&marker=lonlat:" ~ center ~ ";type:material;color:%23d0621e;size:large&apiKey=" ~ meta.mapApiKey -%}
{%- set mapOsm = "https://www.openstreetmap.org/?mlat=" ~ mapLat ~ "&mlon=" ~ mapLon ~ "#map=" ~ mz ~ "/" ~ mapLat ~ "/" ~ mapLon -%}
<a class="place-map-static no-indicator" href="{{ mapOsm }}" target="_blank" rel="noopener">
  <img eleventy:optional="placeholder" src="{{ mapSrc | safe }}" alt="Map showing where {{ mapSubject }}{% if mapPlace %}, near {{ mapPlace }}{% endif %}" loading="lazy" eleventy:widths="640,1280" sizes="(min-width: 82rem) 72rem, 100vw">
</a>
