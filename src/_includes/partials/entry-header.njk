{# Shared chrome header for post-type layouts (post, note, reading, jam, watching, ...).
   The per-type layout wraps this inside <div class="region"><div class="wrapper flow prose">,
   so this partial only renders the title/image/meta block. Tags moved to entry-footer.njk. #}

{# The page heading is always shown: it's the document outline / SEO / microformats
   `p-name`. With the breadcrumb on it sits just below the trail (the standard
   breadcrumb + heading pattern); with the breadcrumb off it's the page's only title. #}
{# titleLang is set (to "sv") only for Swedish activity titles — see eleventyComputed.js.
   Other post types leave it undefined, so the h1 stays at the page's language. #}
{% if title %}
  <h1 class="p-name"{% if titleLang %} lang="{{ titleLang }}"{% endif %}>{{ title }}</h1>
{% endif %}

{# The featured image is always a lightbox. credit renders as the figcaption,
   outside the clickable area ("credit" was never a shortcode option — the old
   pass-through silently dropped it). sizes matches the .feature breakout
   width, same as the photo layout's hero. #}
{% if image %}
  {%
    imageKeys {
      "src": image,
      "alt": alt or "",
      "caption": credit,
      "loading": "eager",
      "containerClass": "feature",
      "sizes": "(min-width: 82rem) 78rem, 100vw",
      "lightbox": true
    }
  %}
{% endif %}

<p class="meta | cluster gutter-xs-s">
  {%- if draft -%}
    <span class="button" data-small-button data-button-variant="tertiary">draft</span>
  {%- endif %}
  {% if date %}
    {% set definedDate = date %}{% include "partials/date.njk" %}
  {% endif %}
  {% if updatedDate %}
     | Updated: {{ updatedDate | formatDate('MMMM D, YYYY') }}
  {% endif %}
</p>
