{# Shared chrome header for post-type layouts (post, note, reading, jam, watching, ...).
   The per-type layout wraps this inside <div class="region"><div class="wrapper flow prose">,
   so this partial only renders the title/image/meta block. Tags moved to entry-footer.njk. #}

{# In the 'breadcrumb' header style the breadcrumb's final crumb carries the visible
   title, so the page's own h1 is kept for the document outline / SEO / microformats
   `p-name` but visually hidden (a type can opt back in with `visibleHeading: true`).
   In the 'logo' header style there is no breadcrumb to name the page, so the h1 is
   always shown. See meta.navigation.headerStyle + header.njk. #}
{% if title %}
  {% set hideHeading = (not visibleHeading) and (meta.navigation.headerStyle !== "logo") %}
  <h1 class="p-name{% if hideHeading %} visually-hidden{% endif %}">{{ title }}</h1>
{% endif %}

{% if image %}
  {%
    imageKeys {
      "src": image,
      "alt": alt or "",
      "credit": credit,
      "loading": "eager",
      "containerClass": "feature"
    }
  %}
{% endif %}

<p class="meta | cluster gutter-xs-s">
  {%- if draft -%}
    <span class="button" data-small-button data-button-variant="tertiary">draft</span>
  {%- endif %}
  {% if date %}
    {% set definedDate = date %}{% include "partials/date.njk" %}
  {% endif %}
  {% if updatedDate %}
     | Updated: {{ updatedDate | formatDate('MMMM D, YYYY') }}
  {% endif %}
</p>
