{# Archive card for the Photo type: photo.src is a local asset, so {% imageKeys %} with keepMetadata, and the licence travels in the file. data-photo keeps the natural aspect ratio for the masonry; u-photo stays on the post page (spec §6). #}

{% set headingLevel = headingLevel | default("h2") %}
{% set definedDate = definedDate | default(item.date) %}
{% set showTags = showTags | default(true) %}

<custom-card clickable data-photo>
  {% if item.data.photo.src %}
    <div slot="image" webc:nokeep>{% imageKeys {"src": item.data.photo.src, "alt": item.data.photo.alt, "keepMetadata": true} %}
    </div>
  {% endif %}
  {% if item.data.title %}
    <{{ headingLevel }} slot="headline" class="text-step-1">
      <a href="{{ item.url | url }}">{{ item.data.title }}</a>
    </{{ headingLevel }}>
  {% endif %}
  <span slot="date">{%- if item.data.draft -%}<span class="button" data-small-button data-button-variant='tertiary'>{{ words.draft }}</span>{%- endif %} {% include "partials/date.njk" %}</span>
  {% if showTags and item.data.tags.length > 1 %}
    <div slot="tag" webc:nokeep>
      {% for tag in item.data.tags %}
        {% if tag != "posts" %}
          <span class="button" data-small-button>{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  <div slot="content" webc:nokeep>{{ item.data.description | markdownFormat | safe }}</div>
  <footer slot="footer" class="repel">
    {{ item.data.category }}
  </footer>
</custom-card>

{% css "local" %}
  {% include "css/custom-card.css" %}
{% endcss %}
