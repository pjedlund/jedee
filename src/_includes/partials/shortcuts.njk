{# KEYBOARD SHORTCUTS — a native dialog that ⌥L opens (shortcuts.js). Mac symbols are the default; a `data-pc` label replaces each one on other systems. The heading takes the opening focus, so a screen reader starts with the title rather than "Close, button". #}
{%- if meta.switches.shortcuts -%}
<dialog id="shortcuts" class="shortcuts | flow" aria-labelledby="shortcuts-title" closedby="any">
  <h2 id="shortcuts-title" tabindex="-1" autofocus>{{ words.keyboardShortcuts }}</h2>
  <dl class="shortcuts-list">
    <dt><kbd><kbd data-pc="Ctrl">⌘</kbd><kbd>K</kbd></kbd></dt>
    <dd>{{ words.shortcutSearch }}</dd>
    <dt><kbd>↓</kbd> <kbd>↑</kbd></dt>
    <dd>{{ words.shortcutMove }}</dd>
    <dt><kbd>Enter</kbd></dt>
    <dd>{{ words.shortcutOpen }}</dd>
    <dt><kbd>Esc</kbd></dt>
    <dd>{{ words.shortcutClose }}</dd>
    {% if meta.switches.devGrid %}
      <dt><kbd><kbd data-pc="Alt">⌥</kbd><kbd>G</kbd></kbd></dt>
      <dd>{{ words.shortcutGrid }}</dd>
      <dt><kbd><kbd data-pc="Alt">⌥</kbd><kbd>R</kbd></kbd></dt>
      <dd>{{ words.shortcutRhythm }}</dd>
    {% endif %}
    <dt><kbd><kbd data-pc="Alt">⌥</kbd><kbd>L</kbd></kbd></dt>
    <dd>{{ words.shortcutList }}</dd>
  </dl>
  <form method="dialog">
    <button class="button">{{ words.close }}</button>
  </form>
</dialog>
{% js "defer" %}{% include "scripts/shortcuts.js" %}{% endjs %}
{%- css "local" -%}{%- include 'css/shortcuts.css' -%}{%- endcss -%}
{%- endif -%}
