<!-- Enhances the slotted static map into a live, maximizable MapLibre map once it scrolls into view (on:visible: most maps sit below the first screen, and the script is ~295 KB). ⚠ Keep on:idle beside it: on:visible alone can fire while the page is still downloading, before the <template> below the slotted table exists, and the script never loads. Mirrors photo-lightbox.webc: is-land is the SOLE root (no sibling style block, else the element renders doubled — see the eleventy-excellent WebC gotcha), with the kept custom element for the JS to upgrade. CSS: css/place-map.css · JS: place-map.js -->
<is-land on:visible on:idle :class="breakout || ''">
  <place-map webc:root webc:keep :data-lat="lat" :data-lon="lon" :data-zoom="zoom" :data-place="place">
    <slot></slot>

    <template data-island="once" webc:raw>
      <link rel="stylesheet" href="/assets/components/maplibre-gl.css" />
      <script type="module" src="/assets/scripts/components/place-map.js"></script>
    </template>
  </place-map>
</is-land>
