<style>
  custom-youtube-link {
    /* Tighten the flow gap from the player: the caption is a credit, not its own section. In prose it also takes the 16:9 player's pad down to the next quarter line. */
    --video-block-size: calc(100% * 9 / 16);
    --flow-space: calc(var(--line-quarter, var(--space-s)) + round(up, var(--video-block-size), var(--line-quarter, 1px)) - var(--video-block-size));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    font-size: var(--size-step-min-1);
  }
  custom-youtube-link svg {
    font-size: var(--size-step-0);
  }
</style>

<custom-svg aria-hidden="true" src="./src/assets/svg/platform/youtube.svg"></custom-svg>
<a :href="href"><span webc:if="label" @text="label" webc:nokeep></span></a>

<!-- Inspired by https://github.com/zachleat/zachleat.com  -->
