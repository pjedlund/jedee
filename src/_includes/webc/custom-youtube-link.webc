<style>
  custom-youtube-link {
    /* Tighten the flow gap from the player above (default 1em) — the caption is a listen credit, not its own section. */
    --flow-space: var(--space-2xs);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--size-step-min-1);
  }
  custom-youtube-link svg {
    font-size: var(--size-step-0);
  }
</style>

<custom-svg aria-hidden="true" src="./src/assets/svg/platform/youtube.svg"></custom-svg>
<a :href="href"><span webc:if="label" @text="label" webc:nokeep></span></a>

