<style>
  custom-peertube-link {
    /* A quarter line under the player, which pads itself down to the lattice. */
    --flow-space: var(--line-quarter, 1em);
    --caption-icon-size: var(--size-step-0);
    --caption-icon-gap: var(--space-xs);
    --caption-icon-color: var(--color-text-subdued);
    --caption-icon-stroke: 0.2ex;
    display: block;
    padding-inline-start: calc(var(--caption-icon-size) + var(--caption-icon-gap));
    font-size: var(--size-step-min-1);
  }
  /* ⚠ Laid out like figcaption and its info icon (global-styles.css): as a flex row Chrome sized the link narrower than its text. */
  custom-peertube-link svg {
    float: inline-start;
    inline-size: var(--caption-icon-size);
    block-size: var(--caption-icon-size);
    margin-block-start: calc((1lh - var(--caption-icon-size)) / 2);
    margin-inline-start: calc(-1 * (var(--caption-icon-size) + var(--caption-icon-gap)));
    color: var(--caption-icon-color);
    stroke-width: var(--caption-icon-stroke);
  }

  /* Keeps the stroke at 0.2ex of the text instead of scaling with the icon's viewBox. */
  custom-peertube-link svg * {
    vector-effect: non-scaling-stroke;
  }
</style>

<custom-svg aria-hidden="true" src="./src/assets/svg/platform/peertube.svg"></custom-svg>
<a :href="href"><span webc:if="label" @text="label" webc:nokeep></span></a>

