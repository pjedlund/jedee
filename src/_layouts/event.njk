---
layout: base
schema: Event
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# The event IS the structured content: a visible h-event carrying the µf2
       properties (spec §5). p-name mirrors the entry-header <h1> as a hidden
       <data> so the event name isn't rendered twice — the h1 is the visible
       name. The h-event nests INSIDE the article's h-entry root (the §6
       entry-root promotion), so it parses as a child h-event of the entry. #}
    <div class="h-event event | flow">
      <data class="p-name" value="{{ title }}"></data>
      {% if description %}<p class="p-summary">{{ description }}</p>{% endif %}

      <dl class="event-meta">
        <dt>When</dt>
        <dd>
          <time class="dt-start" datetime="{{ event.start | toIsoString }}">{{ event.start | formatDate('D MMM YYYY, HH:mm') }}</time>
          {%- if event.end %} &ndash; <time class="dt-end" datetime="{{ event.end | toIsoString }}">{{ event.end | formatDate('D MMM YYYY, HH:mm') }}</time>{% endif %}
        </dd>
        {% if event.location %}<dt>Where</dt><dd class="p-location">{{ event.location }}</dd>{% endif %}
        {% if event.url %}<dt>Link</dt><dd><a class="u-url" href="{{ event.url }}">{{ event.url }}</a></dd>{% endif %}
      </dl>

      {% if event.status and event.status != "scheduled" %}
        <p class="event-status" data-status="{{ event.status }}">{{ event.status | replace("-", " ") | capitalize }}</p>
      {% endif %}
    </div>

    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/event-status.css' -%}
{%- endcss -%}
