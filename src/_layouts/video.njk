---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# One type, three rendering paths, selected by video.provider (spec §6).
       The two embed paths reuse the SHIPPED custom-youtube / custom-peertube
       WebC components — they render here because the WebC plugin runs with
       useTransform:true (so custom elements process in .njk, not only .webc).
       Self-hosted video carries u-video; embeds carry no file URL, so no
       u-video (documented µf2 limitation, spec §5). #}
    {% if video.provider == "file" and video.src %}
      <video class="u-video" controls preload="metadata"{% if video.poster %} poster="{{ video.poster | replace('./src', '') }}"{% endif %} src="{{ video.src | replace('./src', '') }}"></video>

    {% elif video.provider == "youtube" %}
      <custom-youtube @slug="{{ video.slug }}" @label="{{ title }}"></custom-youtube>

    {% elif video.provider == "peertube" %}
      <custom-peertube @instance="{{ video.instance }}" @embed-slug="{{ video.embedSlug }}" @slug="{{ video.slug }}" @label="{{ title }}"></custom-peertube>
    {% endif %}

    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
{%- endcss -%}
