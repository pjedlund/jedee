---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# The photo is the content, so u-photo goes on the visible <img> via the shortcode's imageClass; keepMetadata carries the licence in the file's XMP. #}
    {# No figcaption here: the photo IS the content and the body paragraph below describes it. The <photo-lightbox> component still supports an optional @caption (outside the link) for reuse on other pages. The photo breaks out wider than the prose column via .feature; widths + sizes are explicit so retina screens get the 2000w candidate at that wider width. #}
    {% if photo.src %}
      {# The full-size raster is the first download entry (carries width/height). #}
      {%- set lbox = false -%}
      {%- if photo.downloads %}{% set lbox = photo.downloads[0] %}{% endif -%}
      <div class="feature">
        {%- if lbox and lbox.url and lbox.width and lbox.height -%}
          <photo-lightbox @href="{{ lbox.url }}" @width="{{ lbox.width }}" @height="{{ lbox.height }}">
            {% imageKeys {"src": photo.src, "alt": photo.alt, "loading": "eager", "imageClass": "u-photo", "widths": [650, 960, 1400, 2000], "sizes": "(min-width: 82rem) 78rem, 100vw", "keepMetadata": true} %}
          </photo-lightbox>
        {%- else -%}
          {% imageKeys {"src": photo.src, "alt": photo.alt, "loading": "eager", "imageClass": "u-photo", "widths": [650, 960, 1400, 2000], "sizes": "(min-width: 82rem) 78rem, 100vw", "keepMetadata": true} %}
        {%- endif -%}
      </div>
    {% endif %}

    {# The body sits under the photo as the larger lede (intro + text-step-1). #}
    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {# Capture/scan metadata + download original + public-domain line. Bare include (no async shortcodes inside) — see the interlinker trap note. #}
    {% include 'partials/photo-meta.njk' %}

    {# Location map — a feature-width element in the 6x12 panoramic frame (2:1), as on audio pages (replaces the old sidebar thumbnail). <place-map> fills the slotted empty box with a live, maximizable map once it scrolls into view. photoExif carries the GPS. #}
    {% set ex = photoExif %}
    {% if ex and ex.gps and not photo.hideMap %}
      {# place-map.njk reads these caller-set variables rather than photoExif, so audio (and later video) can slot the same box in from plain front matter. #}
      {% set mapPlace = ex.place.city if (ex.place and ex.place.city) else "" %}
      {% set mapLat = ex.gps.lat %}
      {% set mapLon = ex.gps.lon %}
      {% set mapZoom = photo.mapZoom or 13 %}
      <div class="feature" style="--place-map-ratio: 2 / 1">
        <place-map @lat="{{ mapLat }}" @lon="{{ mapLon }}" @zoom="{{ mapZoom }}" @place="{{ mapPlace }}">
          {% include "partials/place-map.njk" %}
        </place-map>
      </div>
    {% endif %}

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>

  {# Received webmentions — OUTSIDE the h-entry root (Lene/Max pattern). Bare include, interlinker-safe. webmentionUrl = the entry's u-url = each mention's wm-target. #}
  {% set webmentionUrl = page.url | url | absoluteUrl(meta.url) %}
  {% include "partials/webmentions.njk" %}
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- if photoExif and photoExif.gps and not photo.hideMap -%}{%- include 'css/place-map.css' -%}{%- include 'css/place-map-overlay.css' -%}{%- include 'css/place-map-places.css' -%}{%- endif -%}
{%- endcss -%}
