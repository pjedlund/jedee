---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# The photo IS the content, so u-photo goes on the visible <img> — set via
       the image shortcode's imageClass param (6th positional arg, image.js:70).
       photo.src is a LOCAL asset, so {% image %} is correct here; the remote-cover
       plain-<img> pattern (reading/watching/jam) does not apply. #}
    {% if photo.src %}
      {%- if photo.downloads.original and photo.downloads.width and photo.downloads.height -%}
        <photo-lightbox @href="{{ photo.downloads.original }}" @width="{{ photo.downloads.width }}" @height="{{ photo.downloads.height }}">
          {% image photo.src, photo.alt, photo.caption, "eager", "", "u-photo" %}
        </photo-lightbox>
      {%- else -%}
        {% image photo.src, photo.alt, photo.caption, "eager", "", "u-photo" %}
      {%- endif -%}
    {% endif %}

    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {# Capture/scan metadata + download original + public-domain line.
       Bare include (no async shortcodes inside) — see the interlinker trap note. #}
    {% include 'partials/photo-meta.njk' %}

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>

  {# Received webmentions — OUTSIDE the h-entry root (Lene/Max pattern). Bare
     include, interlinker-safe. webmentionUrl = the entry's u-url = each mention's wm-target. #}
  {% set webmentionUrl = page.url | url | absoluteUrl(meta.url) %}
  {% include "partials/webmentions.njk" %}
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/photo-lightbox.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/webmentions.css' -%}
{%- endcss -%}
