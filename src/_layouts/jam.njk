---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# Cover renders as a plain <img> (the Image transform self-hosts remote URLs and resolves local paths); never the {% image %} shortcode, which is local-only and errors on a remote URL. Alt text comes from `coverAlt` when the post writes one. `default` substitutes only on UNDEFINED, so `coverAlt: ""` is honoured as empty — the right answer for a cover that just repeats the title beside it. #}
    {% if cover %}
      <img class="cover" eleventy:optional="placeholder" src="{{ cover | safe }}" alt="{{ coverAlt | default('Cover for ' + title) }}" loading="lazy" eleventy:widths="160,224,448" sizes="auto">
    {% endif %}

    {# Optional embedded performance (e.g. an archived This Is My Jam YouTube link). Reuses the shipped custom-youtube WebC component, which renders here because the WebC plugin runs with useTransform:true (same pattern as video.njk). #}
    {% if youtubeSlug %}
      <custom-youtube @slug="{{ youtubeSlug }}" @poster="{{ youtubeSlug | youtubePoster }}" @label="{{ title }}"></custom-youtube>
    {% endif %}

    {% if source %}<data hidden class="u-listen-of" value="{{ source }}"></data>{% endif %}

    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {# Genre chips link into the /jams/genre/ index, which is built from this same
       `genre` field and stays out of /tags/ on purpose (see genreList in
       src/_config/collections.js). Slugged the same way the collection groups,
       so a chip can't point at a page that doesn't exist. #}
    {% if genre %}
      {# A clipper template set to `text` rather than `multitext` yields a single
         string here, which a bare {% for %} would walk character by character. #}
      {% set genres = [genre] if genre is string else genre %}
      <ul class="my-s-m cluster gutter-s" role="list">
        {% for name in genres | unwikilink %}
          <li>
            <a href="/jams/genre/{{ name | slugify }}/" class="button" data-small-button>{{ name }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>

  {# This Is My Jam likes + comments (recovered from the Internet Archive) — OUTSIDE the h-entry root, like received webmentions, so the h-cite cards don't nest as children of the entry. Bare include, interlinker-safe. Renders nothing when the jam has no recovered social data. #}
  {% include 'partials/jam-social.njk' %}
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/cover.css' -%}
  {%- include 'css/webmentions.css' -%}
{%- endcss -%}
