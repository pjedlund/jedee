---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# Cover renders as a plain <img> (the Image transform self-hosts remote URLs and resolves
       local paths); never the {% image %} shortcode, which is local-only and errors on a remote URL. #}
    {% if cover %}
      <img class="cover" eleventy:optional="placeholder" src="{{ cover | safe }}" alt="Cover for {{ title }}" loading="lazy" eleventy:widths="160,224,448" sizes="auto">
    {% endif %}

    {# Optional embedded performance (e.g. an archived This Is My Jam YouTube link).
       Reuses the shipped custom-youtube WebC component, which renders here because
       the WebC plugin runs with useTransform:true (same pattern as video.njk). #}
    {% if youtube %}
      <custom-youtube @slug="{{ youtube }}" @label="{{ title }}"></custom-youtube>
    {% endif %}

    {% if source %}<data hidden class="u-listen-of" value="{{ source }}"></data>{% endif %}

    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>

  {# This Is My Jam likes + comments (recovered from the Internet Archive) — OUTSIDE
     the h-entry root, like received webmentions, so the h-cite cards don't nest as
     children of the entry. Bare include, interlinker-safe. Renders nothing when the
     jam has no recovered social data. #}
  {% include 'partials/jam-social.njk' %}
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/cover.css' -%}
  {%- include 'css/webmentions.css' -%}
{%- endcss -%}
