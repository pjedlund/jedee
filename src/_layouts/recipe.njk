---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    {% include 'partials/entry-header.njk' %}

    {% if description %}<p>{{ description }}</p>{% endif %}

    {# Dish photo is cover-style: a remote URL (clipped) or a local passthrough
       path (hand-authored). A plain <img> lets eleventy-img's HTML Transform
       self-host a remote src and optimize a local one — the {% image %}
       shortcode is local-only (it prepends ./src and breaks on a remote URL). #}
    {% if cover %}
      <img class="cover" eleventy:optional="placeholder" src="{{ cover | safe }}" alt="{{ title }}" loading="lazy" eleventy:widths="320,640,960" sizes="auto">
    {% endif %}

    {% if yield or totalTime %}
      <dl class="recipe-meta">
        {% if yield %}<dt>Yields</dt><dd>{{ yield }}</dd>{% endif %}
        {% if totalTime %}<dt>Total time</dt><dd><time datetime="{{ totalTime | toISODuration }}">{{ totalTime | formatDuration }}</time></dd>{% endif %}
      </dl>
    {% endif %}

    {# Ingredients + instructions live in the note body as markdown (kepano
       shape) — the Obsidian Web Clipper can't emit a nested `recipe:` object,
       so a recipe is a body-driven post like every other type. #}
    <div class="e-content | flow">
      {{ content | safe }}
    </div>

    {% if source %}<p class="recipe-source">Recipe from <a href="{{ source }}">{{ source }}</a></p>{% endif %}

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
  </div>

  {# h-card authorship for Webmention discovery — https://indieweb.org/authorship #}
  <div hidden class="h-entry">
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.url) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.url) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/cover.css' -%}
{%- endcss -%}
