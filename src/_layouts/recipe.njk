---
layout: base
schema: Recipe
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    {% include 'partials/entry-header.njk' %}

    {# The recipe IS structured content: a visible h-recipe carrying the µf2
       properties (spec §5). p-name mirrors the entry-header <h1> as a hidden
       <data> so the recipe name isn't rendered twice — the h1 is the visible
       name. The h-recipe sits outside the hidden h-entry authorship block; that
       root-nesting caveat is the shared, deferred webmention-milestone fix
       (spec §5/§14), sharper here than the media types because it orphans a
       microformat root rather than a u-* property. #}
    <div class="h-recipe recipe flow">
      <data class="p-name" value="{{ title }}"></data>
      {% if description %}<p class="p-summary">{{ description }}</p>{% endif %}

      {% if recipe.yield or recipe.totalTime %}
        <dl class="recipe-meta">
          {% if recipe.yield %}<dt>Yields</dt><dd class="p-yield">{{ recipe.yield }}</dd>{% endif %}
          {% if recipe.totalTime %}<dt>Total time</dt><dd><time class="dt-duration" datetime="{{ recipe.totalTime | toISODuration }}">{{ recipe.totalTime | formatDuration }}</time></dd>{% endif %}
        </dl>
      {% endif %}

      {# Dish photo is a LOCAL asset → {% image %} (u-photo lands via the 6th
         positional imageClass arg, image.js:70). Optional; the block, card,
         feed, and schema all degrade gracefully when it's absent. #}
      {% if recipe.image %}
        {% image recipe.image, title, "", "eager", "", "u-photo" %}
      {% endif %}

      <h2>Ingredients</h2>
      <ul>
        {% for item in recipe.ingredients %}<li class="p-ingredient">{{ item }}</li>{% endfor %}
      </ul>

      <h2>Instructions</h2>
      <ol class="e-instructions">
        {% for step in recipe.instructions %}<li>{{ step }}</li>{% endfor %}
      </ol>
    </div>

    <div class="e-content">
      {{ content | safe }}
    </div>

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
  </div>

  {# h-card authorship for Webmention discovery — https://indieweb.org/authorship #}
  <div hidden class="h-entry">
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.url) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.url) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
{%- endcss -%}
