---
layout: base
---

{# Public LLM wiki page with the full site chrome (header/nav/breadcrumb, footer, theme toggle — all from base.njk). Unlike post.njk this is NOT an h-entry: no microformats, no webmentions, no feed, no entry-footer — so the posts' IndieWeb machinery never sees it. See the spec, _local/generated/_archive/Plan - Wiki as a real post type.md. The eyebrow's /wiki/ link doubles as the way back to the index; on the index page it's a harmless self-link. #}
<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  {# _log is ~40 dated entries rather than an essay, so its h2s get the compact entry treatment in wiki.css. #}
  <article class="wrapper flow prose"{% if page.fileSlug == "_log" %} data-wiki-log{% endif %}>
    <p class="wiki-eyebrow | popout">
      {% svg "misc/info" %}<span>{{ words.wikiPartOf }} <a href="/wiki/">{{ words.wikiName }}</a>{% if settings.wiki.attribution %} — {{ settings.wiki.attribution }}{% endif %}</span>
    </p>

    <h1>{{ title }}</h1>

    {% if date %}
      <p class="meta | cluster gutter-s-m">
        {%- set revision = page.inputPath | gitRevision(date) %}
        {%- set mf2 = false %}{% include "partials/meta-dates.njk" %}
      </p>
    {% endif %}

    <div class="wrapper-pass flow">
      {{ content | safe }}
    </div>

    {% include 'partials/backlinks.njk' %}
  </article>
</div>

{%- css "local" -%}
  {%- include 'css/wiki.css' -%}
  {%- include 'css/meta.css' -%}
{%- endcss -%}
