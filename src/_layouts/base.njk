{% set assetHash = helpers.random() %}

<!doctype html>
<html lang="{{ meta.lang }}">
  <!-- The order of elements in the head follows recommendations by Harry Roberts. learn more here: https://www.youtube.com/watch?v=MHyAOZ45vnU -->

  <head>
    <!-- 1 charset/viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 2 title -->
    <title>
      {%- if title -%}
        {{- title -}}
      {%- else -%}
        {{- meta.siteName -}}
      {%- endif -%}
    </title>

    <base href="{{ page.url }}" />

    <!-- 3 synchronous js  -->
    {% include "head/js-inline.njk" %}

    <!-- 4 schema settings -->
    {% include "head/schema.njk" %}

    <!-- 5 CSS  -->
    <!-- <link rel="stylesheet" href="/assets/css/global.css?{{ assetHash }}" /> -->
    {% include "head/css-inline.njk" %}

    <!-- 6 preloads  -->
    {% include "head/preloads.njk" %}

    <!-- 7 defer  -->
    {% include "head/js-defer.njk" %}

    <!-- 7b third-party analytics (deferred, deployed builds only)  -->
    {% include "head/js-analytics.njk" %}

    <!-- 8 meta tags, icons, open graph etc.  -->
    {% include "head/meta-info.njk" %}

    <!-- 9 hover prefetching -->
    {% include "head/speculation-rules.njk" %}
  </head>

  <body class="{{ layout }}">
    {% set indicateActiveHome %}
      {% if page.url == "/" %}
        aria-current=page
      {% endif %}
    {% endset %}
    {% include "partials/header.njk" %}

    <main id="main" class="flow">{{ content | safe }}</main>
    {# ⚠ Keep the `content and` guard: unguarded, .includes() throws in a render where content is undefined and every wikilink on the site silently turns into plain text. #}
    {%- if content and content.includes('<table') -%}
      {%- css "local" -%}{%- include 'css/table.css' -%}{%- endcss -%}
    {%- endif -%}

    {% include "partials/footer.njk" %}
    {% if eleventy.env.runMode === "serve" %}
      {% js "defer" %}{% include "scripts/font-check.js" %}{% endjs %}
    {% endif %}
    {%- if meta.easteregg -%}
      <script type="module" src="/assets/scripts/components/custom-easteregg.js"></script>
      <custom-easteregg{% if meta.eastereggKeyword %} keyword="{{ meta.eastereggKeyword }}"{% endif %}{% if meta.eastereggShape %} shape="{{ meta.eastereggShape }}"{% endif %}></custom-easteregg>
    {%- endif -%}
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/serviceworker.js')
      }
    </script>
  </body>
</html>
