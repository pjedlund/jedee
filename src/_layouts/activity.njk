---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <article class="wrapper flow prose h-entry">
    {% include 'partials/entry-header.njk' %}

    {# An activity's cover is the race map, printed small beside the stats — too small to read,
       so it opens in the PhotoSwipe lightbox. Unlike the other cover-carrying types (reading,
       watching, jam, recipe), these covers are always LOCAL scans under
       /assets/images/activities/, so the local-only {% imageKeys %} shortcode is safe here where
       those layouts need a plain <img> for their remote URLs. Alt text comes from `coverAlt` when
       the post writes one; `default` substitutes only on UNDEFINED, so `coverAlt: ""` is honoured
       as empty.

       The widths are three page candidates plus the zoom target. 224 is the displayed size, 448
       covers a 2x screen, 900 keeps the first frame of an opened lightbox cheap on a laptop — and
       `null` means the ORIGINAL, whatever that is: eleventy-img never upscales, so each map tops
       out at its own scan (up to 4032px) rather than a shared 1600px ceiling. That top candidate
       is what PhotoSwipe zooms into, and reading a control description off a 1:7500 map wants
       every pixel the scan has. #}
    {% if cover %}
      {%
        imageKeys {
          "src": cover,
          "alt": coverAlt | default('Cover for ' + title),
          "containerClass": "cover-zoom",
          "imageClass": "cover",
          "widths": [224, 448, 900, null],
          "sizes": "14rem",
          "lightbox": true
        }
      %}
    {% endif %}

    {# Recorded data for /activities/. No standard mf2 property exists for an activity's
       stats, so this is plain semantic markup (a description list) — the entry stays
       a valid h-entry on title (p-name) + date (dt-published) + commentary (e-content).
       Pace/speed is DERIVED here from the stored raw numbers; duration is seconds ->
       clock via the shared itunesDuration filter. #}
    <dl class="activity-stats | cluster">
      {% if distanceKm %}
        <div><dt>Distance</dt><dd>{{ distanceKm | withMiles }}</dd></div>
      {% endif %}
      <div><dt>Duration</dt><dd>{{ duration | itunesDuration }}</dd></div>
      {% set pace = activityType | paceOrSpeed(distanceKm, duration) %}
      {% if pace %}
        <div><dt>Pace</dt><dd>{{ pace }}</dd></div>
      {% endif %}
      {% if hrAvg %}
        <div><dt>Heart rate</dt><dd>{{ hrAvg }}{% if hrMax %} ({{ hrMax }} max){% endif %}</dd></div>
      {% endif %}
      {% if elevationGain %}
        <div><dt>Elevation</dt><dd>+{{ elevationGain }} m{% if elevationLoss %} / -{{ elevationLoss }} m{% endif %}</dd></div>
      {% endif %}
      {% if energyKcal %}
        <div><dt>Energy</dt><dd>{{ energyKcal }} kcal</dd></div>
      {% endif %}
    </dl>

    {% if stravaUrl or liveloxUrl or eventorUrl %}
      <p class="cluster gutter-xs-s">
        {% if stravaUrl %}<a class="button" data-small-button href="{{ stravaUrl }}">View on Strava</a>{% endif %}
        {% if liveloxUrl %}<a class="button" data-small-button href="{{ liveloxUrl }}">View on Livelox</a>{% endif %}
        {% if eventorUrl %}<a class="button" data-small-button href="{{ eventorUrl }}">View on Eventor</a>{% endif %}
      </p>
    {% endif %}

    {# Captions are free prose Johan writes — almost always Swedish for orienteering
       events, so activities.json defaults captionLang to "sv"; a rare English caption
       sets `captionLang: en` in its own front matter. #}
    {% if content %}
      <div class="e-content | flow"{% if captionLang %} lang="{{ captionLang }}"{% endif %}>
        {{ content | safe }}
      </div>
    {% endif %}

    {% include 'partials/backlinks.njk' %}
    {% include 'partials/entry-footer.njk' %}
    {% include 'partials/hidden-author.njk' %}
  </article>
</div>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
  {%- include 'css/activity.css' -%}
  {%- include 'css/cover.css' -%}
{%- endcss -%}
