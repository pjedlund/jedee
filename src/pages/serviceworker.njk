//service worker by Max Böck https://github.com/maxboeck/eleventastic/blob/master/src/serviceworker.njk
//extended with runtime caching: visited pages + their assets are cached and
//served offline, so the offline page is only the fallback for never-seen URLs.
const CACHE_NAME = 'cache-{{ buildTime|toIsoString}}'
const OFFLINE_PAGE_URL = '/offline/'

// Warm the cache on install with the offline fallback and a couple of stable
// entry points. Everything else (CSS/JS bundles, fonts, images) is cached at
// runtime as it's first requested — so the hashed /bundle/<hash>.css paths,
// which can't be hardcoded here, get cached automatically on the first visit.
const PRECACHE_RESOURCES = [
  '/',
  '/favicon.ico',
  '/favicon.svg',
  '/icon-192x192.png',
  '/icon-512x512.png',
  '/maskable-icon.png',
  '/apple-touch-icon.png'
]

// Hosts the worker passes straight through — no caching, no offline
// interception — so the dev server's live reload and freshly-edited assets are
// never masked by the cache. The worker still registers on localhost; it just
// does nothing there. Empty in production.
const IGNORED_HOSTS = ['localhost', '127.0.0.1']

// On Install
self.addEventListener('install', (event) => {
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE_NAME)

      // add all resources we want to precache first
      if (PRECACHE_RESOURCES.length) {
        await cache.addAll(PRECACHE_RESOURCES)
      }

      // then add the offline page.
      // Setting {cache: 'reload'} in the new request will ensure that the
      // response isn't fulfilled from the HTTP cache; i.e., it will be from
      // the network.
      await cache.add(new Request(OFFLINE_PAGE_URL, { cache: 'reload' }))
    })()
  )
  // Force the waiting service worker to become the active service worker.
  self.skipWaiting()
})

// On Activation
self.addEventListener('activate', (event) => {
  event.waitUntil(
    (async () => {
      // Enable navigation preload if it's supported.
      // See https://developers.google.com/web/updates/2017/02/navigation-preload
      if ('navigationPreload' in self.registration) {
        await self.registration.navigationPreload.enable()
      }

      // clear out any old caches that might still be around
      const cacheNames = await caches.keys()
      await Promise.all(
        cacheNames.map((cacheName) => {
          if (cacheName !== CACHE_NAME) {
            return caches.delete(cacheName)
          }
        })
      )
    })()
  )

  // Tell the active service worker to take control of the page immediately.
  self.clients.claim()
})

// Put a copy in the cache without blocking the response or letting a failed
// put (redirects, partial 206s) swallow a good network response.
const cacheCopy = (event, response) => {
  const copy = response.clone()
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => cache.put(event.request, copy)).catch(() => {})
  )
}

// On Request
self.addEventListener('fetch', (event) => {
  const { request } = event
  const url = new URL(request.url)

  // Dev bypass: skip the worker entirely on localhost so live reload and
  // freshly-edited assets are never served stale from the cache.
  if (IGNORED_HOSTS.includes(url.hostname)) return

  // Only same-origin GETs are cacheable; let everything else hit the network
  // untouched (POSTs, hotlinked cross-origin avatars, etc.).
  if (request.method !== 'GET' || url.origin !== self.location.origin) {
    return
  }

  // Page navigations: network-first so content stays fresh, but keep a copy.
  // Offline → the cached page if we've visited it, else the offline fallback.
  if (request.mode === 'navigate') {
    event.respondWith(
      (async () => {
        try {
          const preloadResponse = await event.preloadResponse
          const response = preloadResponse || (await fetch(request))
          cacheCopy(event, response)
          return response
        } catch (error) {
          return (await caches.match(request)) || (await caches.match(OFFLINE_PAGE_URL))
        }
      })()
    )
    return
  }

  // Static assets (css/js/fonts/images): cache-first, fill the cache on miss.
  // ponytail: unbounded cache, but CACHE_NAME is versioned per build and old
  // caches are deleted on activate, so every deploy clears it. Add per-type
  // expiration (or Workbox) only if the cache ever grows uncomfortable.
  event.respondWith(
    (async () => {
      const cached = await caches.match(request)
      if (cached) return cached
      const response = await fetch(request)
      if (response.ok) cacheCopy(event, response)
      return response
    })()
  )
})
