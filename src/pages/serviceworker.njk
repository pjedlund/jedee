//service worker by Max Böck https://github.com/maxboeck/eleventastic/blob/master/src/serviceworker.njk
//extended with runtime caching: visited pages and their assets are served offline, the offline page is the fallback for never-seen URLs.
const CACHE_NAME = 'cache-{{ buildTime|toIsoString}}'
// Caches a site keeps across updates (settings.pwa.keepCaches), such as a log the visitor's data lives in.
const KEEP_CACHES = {{ meta.pwa.keepCaches | dump | safe }}
const OFFLINE_PAGE_URL = '/offline/'

// Warmed on install; everything else is cached as it is first requested. A file missing from this list, the offline page included, is skipped, so it never stops the worker installing.
const PRECACHE_RESOURCES = [
  '/',
  '/favicon.ico',
  '/favicon.svg',
  '/icon-192x192.png',
  '/icon-512x512.png',
  '/maskable-icon.png',
  '/apple-touch-icon.png'
]

// Passed straight through, so the dev server's live reload is never masked by the cache. Empty in production.
const IGNORED_HOSTS = ['localhost', '127.0.0.1']

// On Install
self.addEventListener('install', (event) => {
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE_NAME)

      // One by one: addAll fails wholesale when a single file is missing.
      await Promise.all(PRECACHE_RESOURCES.map((resource) => cache.add(resource).catch(() => {})))

      // {cache: 'reload'} fetches the offline page from the network, not the HTTP cache.
      await cache.add(new Request(OFFLINE_PAGE_URL, { cache: 'reload' })).catch(() => {})
    })()
  )
  self.skipWaiting()
})

// On Activation
self.addEventListener('activate', (event) => {
  event.waitUntil(
    (async () => {
      // Navigation preload, where supported: https://developers.google.com/web/updates/2017/02/navigation-preload
      if ('navigationPreload' in self.registration) {
        await self.registration.navigationPreload.enable()
      }

      // Clear out old caches, but not the ones the site keeps.
      const cacheNames = await caches.keys()
      await Promise.all(
        cacheNames.map((cacheName) => {
          if (cacheName !== CACHE_NAME && !KEEP_CACHES.includes(cacheName)) {
            return caches.delete(cacheName)
          }
        })
      )
    })()
  )

  self.clients.claim()
})

// ⚠ Never let a failed put (redirects, partial 206s) swallow a good network response.
const cacheCopy = (event, response) => {
  const copy = response.clone()
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => cache.put(event.request, copy)).catch(() => {})
  )
}

// On Request
self.addEventListener('fetch', (event) => {
  const { request } = event
  const url = new URL(request.url)

  if (IGNORED_HOSTS.includes(url.hostname)) return

  // Only same-origin GETs are cached; POSTs and cross-origin requests go to the network untouched.
  if (request.method !== 'GET' || url.origin !== self.location.origin) {
    return
  }

  // Pages: network-first, keeping a copy. Offline: the cached page, else the offline fallback.
  if (request.mode === 'navigate') {
    event.respondWith(
      (async () => {
        try {
          const preloadResponse = await event.preloadResponse
          const response = preloadResponse || (await fetch(request))
          cacheCopy(event, response)
          return response
        } catch (error) {
          const cache = await caches.open(CACHE_NAME)
          return (await cache.match(request)) || (await cache.match(OFFLINE_PAGE_URL))
        }
      })()
    )
    return
  }

  // ponytail: Assets are cache-first, filled on a miss. The cache is unbounded, but its name changes every build, so each deploy clears it.
  event.respondWith(
    (async () => {
      const cache = await caches.open(CACHE_NAME)
      const cached = await cache.match(request)
      if (cached) return cached
      const response = await fetch(request)
      if (response.ok) cacheCopy(event, response)
      return response
    })()
  )
})
