---
title: Activities
description: 'A log of my activities.'
permalink: /activities/index.html
layout: page
---

{% if collections.workout.length %}
<p>Running, orienteering and other physical activities. Newest first.</p>

<div class="grid" style="--grid-min-item-size: 18rem">
  {% for item in collections.workout %}
    {% include "partials/card-workout.njk" %}
  {% endfor %}
</div>
{% else %}
{# Parked fallback: the Strava bulk-CSV table, kept live until real workout posts
   exist. Once enough posts have landed, retire this whole branch + the CSV machinery
   (src/_data/strava.js, src/_config/strava-export.js, __strava/). See the
   project_jedee_strava_training_page memory. #}
<p>My most recent public activities, pulled from Strava when the site builds. Multi-sport, metric, newest first.</p>

{%- css "local" -%}
  {% include "css/training.css" %}
{%- endcss -%}

{% if strava.length %}
<div class="training-scroll" tabindex="0" role="region" aria-label="Training activities">
  <table class="training-log">
    <thead>
      <tr>
        <th scope="col">Type</th>
        <th scope="col">Date</th>
        <th scope="col">Distance</th>
        <th scope="col">Duration</th>
        <th scope="col">Pace / speed</th>
        <th scope="col">Heart rate</th>
        <th scope="col">Note</th>
      </tr>
    </thead>
    <tbody>
      {% for a in strava %}
      <tr>
        <td><a href="https://www.strava.com/activities/{{ a.id }}">{{ a.type }}</a></td>
        <td>{{ a.date }}</td>
        <td>{% if a.distanceKm %}{{ a.distanceKm }} km{% endif %}</td>
        <td>{{ a.duration }}</td>
        <td>{{ a.paceOrSpeed }}</td>
        <td>{% if a.hrAvg %}{{ a.hrAvg }}{% if a.hrMax %} ({{ a.hrMax }}){% endif %}{% endif %}</td>
        <td>{{ a.note }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p>No public activities to show yet.</p>
{% endif %}
{% endif %}
