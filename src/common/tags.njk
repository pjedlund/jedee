---
layout: tags
permalink: /tags/index.html
# pagination only gates the file: nothing in tagList, no page
pagination:
  data: collections.tagList
  size: 100000
eleventyComputed:
  title: '{{ meta.blog.tagPlural }}'
---

<div class="taglist | mt-s-m cluster">
  {% for tag in collections.tagList %}
    <a href="/tags/{{ tag | slugify }}/" class="button" data-small-button> {{ tag }} </a>
  {% endfor %}
</div>

<custom-masonry layout="50-50">
  {% set itemlist = collections.posts %}
  {% for item in itemlist %}

		{% include "partials/card-tag.njk" %}
  {% endfor %}
</custom-masonry>
