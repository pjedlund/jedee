---
fontDisplay: "Source Serif 4" # needed created in local development, font must be installed on your system.
fontBody: "Source Sans 3" # needed created in local development, font must be installed on your system.
background: '#F4F4F2'
textColor: '#495464'
colorMediumDark: '#bbbfca'
colorLightGrey: '#e8e8e8'
accentColor: '#d0621e' # --color-accent-orange, the mark's own fill in src/assets/svg/misc/logo.svg
pagination:
  data: collections.article
  size: 1
  alias: post
permalink: '/assets/og-images/{{ post.data.title | slugify }}-preview.svg'
eleventyExcludeFromCollections: true
---

<svg
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
  version="1.1"
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
>
  {% set titleInLines = post.data.title | splitlines(22) %}
  {% set numberOfLines = titleInLines.length %}
  {% if numberOfLines == 1 %}
    {% set verticalStartingPoint = 340 %}
    {% elseif numberOfLines == 2 %}
    {% set verticalStartingPoint = 290 %}
    {% elseif numberOfLines == 3 %}
    {% set verticalStartingPoint = 250 %}
    {% elseif numberOfLines == 4 %}
    {% set verticalStartingPoint = 210 %}
    {% elseif numberOfLines == 5 %}
    {% set verticalStartingPoint = 170 %}
  {% endif %}

  <rect id="bg" width="100%" height="100%" opacity="1" fill="{{ background }}" />
  <!-- ground: the site's own mark where Eleventy Excellent's template put its star. Same size, position and 10% as the fallback card in generate-og-default.js, so the two read as one set. -->
  <g transform="translate(666,96) scale(4.38,4.38)">
    <path fill="{{ accentColor }}" opacity="0.1" d="m50 0 .588.003V0h9.706v30.882h-9.706v.009a19 19 0 0 0-.588-.009c-10.558 0-19.118 8.559-19.118 19.118S39.441 69.118 50 69.118 69.118 60.559 69.118 50V30.882C69.118 13.826 82.945 0 100 0v50c0 27.614-22.386 50-50 50S0 77.614 0 50 22.386 0 50 0" />
  </g>

  <!-- date -->
  <text
    font-family="{{ fontBody }},sans-serif"
    font-size="18"
    font-weight="500"
    fill="{{textColor}}"
  >
    <tspan x="160" y="{{ verticalStartingPoint - 120 }}">
      {{ post.date | formatDate('YYYY/MM/DD') }}
    </tspan>
  </text>

  <!-- title -->
  <text
    id="text"
    font-family="'Source Serif 4',serif"
    font-size="80"
    font-weight="700"
    letter-spacing="-1"
    fill="{{ textColor }}"
  >
    {% for line in titleInLines %}
      <tspan x="160" y="{{ verticalStartingPoint - 20 + loop.index0 * 85 }}"> {{ line }} </tspan>
    {% endfor %}
  </text>

  {# <!-- url --> <text
    font-family="Dank Mono"
    font-size="20"
    font-style="italic"
    font-weight="300"
    letter-spacing="-1"
    fill="{{ textColor }}" >
    <tspan x="160" y="580">{{ meta.siteDomain }}</tspan> </text> #}


  <!-- sitename -->
  <text
    font-family="{{ fontBody }}, sans-serif"
    font-size="18"
    font-weight="600"
    fill="#bbbfca"
    letter-spacing="-1"
  >
    <tspan x="950" y="580">{{ meta.siteDomain }}</tspan>
  </text>

  <!-- signature mark, in the accent orange. ⚠ It was the base-dark grey #bbbfca here, the value that measured 1.67 on the light page and was fixed everywhere else on the site. -->
  <g transform="translate(916,560) scale(0.2,0.2)">
    <path fill="{{ accentColor }}" d="m50 0 .588.003V0h9.706v30.882h-9.706v.009a19 19 0 0 0-.588-.009c-10.558 0-19.118 8.559-19.118 19.118S39.441 69.118 50 69.118 69.118 60.559 69.118 50V30.882C69.118 13.826 82.945 0 100 0v50c0 27.614-22.386 50-50 50S0 77.614 0 50 22.386 0 50 0" />
  </g>
</svg>
