{
  "name": "jedee",
  "version": "0.10.0",
  "description": "Personal website of Johan Edlund.",
  "author": "Johan Edlund",
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.x.x"
  },
  "scripts": {
    "clean": "rimraf dist src/_includes/css src/_includes/scripts",
    "clean:og": "rimraf src/assets/og-images",
    "fallback-font-style": "node ./src/_config/setup/fallback-font-style.js",
    "favicons": "node ./src/_config/setup/generate-favicons.js",
    "og:default": "node ./src/_config/setup/generate-og-default.js",
    "og:cards": "node ./src/_config/setup/generate-og-cards.js",
    "colors": "node ./src/_config/setup/create-colors.js",
    "design:md": "node ./src/_config/setup/build-design-md.js",
    "design:system": "node ./src/_config/setup/build-design-system.js",
    "genres:fetch": "node ./src/_config/setup/enrich-genres.js fetch",
    "genres:apply": "node ./src/_config/setup/enrich-genres.js apply",
    "descriptions:fetch": "node ./src/_config/setup/genre-descriptions.js fetch",
    "descriptions:build": "node ./src/_config/setup/genre-descriptions.js build",
    "penpot:tokens": "node ./src/_config/setup/build-penpot-tokens.js && node ./src/_config/setup/build-design-md.js",
    "figma:tokens": "node ./src/_config/setup/build-figma-tokens.js",
    "dev:11ty": "cross-env ELEVENTY_ENV=development NODE_OPTIONS=--max-old-space-size=8192 eleventy --serve --incremental",
    "build:11ty": "cross-env ELEVENTY_ENV=production eleventy",
    "start": "until npm run dev:11ty; do echo '↻ dev server ran out of memory — restarting'; sleep 2; done",
    "dev:mem": "cross-env ELEVENTY_ENV=development MEMLOG=1 NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' eleventy --serve --incremental",
    "build": "npm run clean && npm run build:11ty",
    "pa11y:build": "npm run clean && cross-env ELEVENTY_ENV=test BUILD_DRAFTS=1 eleventy",
    "pa11y:test": "sleep 3 && pa11y-ci --config ./dist/pa11y.json",
    "pa11y:serve": "cross-env ELEVENTY_ENV=test BUILD_DRAFTS=1 eleventy --serve --ignore-initial",
    "test:a11y": "npm run pa11y:build && (npm run pa11y:serve &) && sleep 5 && npm run pa11y:test",
    "flags": "grep -rn \"@until\" src netlify admin eleventy.config.js || echo 'No expiring comments.'",
    "test:unit": "node --test tests/*.test.js",
    "rebuild": "mkdir -p dist/assets && find dist -mindepth 1 -maxdepth 1 ! -name assets ! -name img -exec rm -rf {} + && find dist/assets -mindepth 1 -maxdepth 1 ! -name images -exec rm -rf {} + && npm run build:11ty",
    "compare": "node tests/compare-builds.mjs _local/baseline dist",
    "mockups": "node src/wiki/_sources/shoot-mockups.js",
    "mockups:check": "node src/wiki/_sources/check-mockups.js"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/pjedlund/jedee.git"
  },
  "overrides": {
    "lodash": "4.18.1",
    "nanoid": "5.1.16"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@11ty/is-land": "^5.0.1",
    "@benjifs/github-store": "^0.2.0",
    "@benjifs/micropub": "^2.0.1",
    "@photogabble/eleventy-plugin-interlinker": "^1.1.0",
    "@protomaps/basemaps": "^5.7.2",
    "canvas-confetti": "^1.9.4",
    "gray-matter": "^4.0.3",
    "lite-youtube-embed": "^0.3.4",
    "maplibre-gl": "^5.24.0",
    "photoswipe": "^5.4.4",
    "pmtiles": "^4.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^3.6.2",
    "@toycode/markdown-it-class": "^1.2.4",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.9.19",
    "colorjs.io": "^0.7.1",
    "cross-env": "^10.1.0",
    "cssnano": "^9.8.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.5.0",
    "markdown-it": "^14.3.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-prism": "^4.0.0",
    "microformats-parser": "^2.0.4",
    "netlify-plugin-cache": "^1.0.3",
    "pa11y-ci": "^5.0.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-js": "^5.1.0",
    "prettier-plugin-jinja-template": "^2.2.0",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "slugify": "^1.6.9",
    "svgo": "^4.1.0"
  }
}
