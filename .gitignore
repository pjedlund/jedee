# All local-only project material lives under one umbrella (anchored so it can
# never match anything inside src/). See _local/generated/Plan - Folder reorg (_local umbrella).md
/_local/

# Local Netlify folder
.netlify

# Obsidian
.obsidian
.vault-nickname
# Vault tooling stays local (Bases, note templates), but the Web Clipper
# templates are tracked — they're the source of truth (see _local/project_docs/web-clipper-pattern.html).
src/_obsidian/*
!src/_obsidian/clipper/

/src/posts/articles/-drafts
# Raw import source texts, not site content
/src/_raw/

.claude
.omc
.github

