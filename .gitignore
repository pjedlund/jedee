# Node modules
node_modules

# generated files
dist
_site
src/_includes/css
src/_includes/scripts

# cache
.cache

# secret data
.env

# Editor configs
.nova
.vscode
.DS_Store

# All local-only project material lives under one umbrella, anchored so it can never match anything inside src/.
/_local/

# Local Netlify folder
.netlify

# Obsidian
.obsidian
.vault-nickname
# Vault tooling stays local (Bases, note templates), but the Web Clipper templates are tracked: they're the source of truth.
src/_obsidian/*
!src/_obsidian/clipper/

/src/posts/articles/-drafts
# Raw import source texts, not site content
/src/_raw/


# Body images the Obsidian local-images plugin pulls from a raw wiki clip belong to their source, not this site; `git add -f` one a post genuinely needs.
/src/assets/images/*_MD5.*

# Uncompressed audio masters run to hundreds of MB: the small derived file ships in src/assets/, the master lives on R2.
*.wav
*.WAV
*.aif
*.aiff
*.flac
*.FLAC

.claude
.omc
.github

# Project notes (kept locally, not in repo); AGENTS.md is tracked on purpose, so keep anything personal out of it
CLAUDE.md
SITE.md
IDEAS.md
LOG.md
TODO.md
ROADMAP.md
# AI tool config, kept local (decided 2026-07-31)
.mcp.json


# Netlify dev regenerates this Edge Functions lockfile on every run; the production build never uses Deno.
deno.lock
