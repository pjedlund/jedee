# Node modules
node_modules

# generated files
dist
_site
src/_includes/css
src/_includes/scripts

# cache
.cache

# secret data
.env

# Editor configs mm
.nova
.vscode
.DS_Store

# All local-only project material lives under one umbrella (anchored so it can
# never match anything inside src/). See _local/generated/Plan - Folder reorg (_local umbrella).md
/_local/

# Local Netlify folder
.netlify

# Obsidian
.obsidian
.vault-nickname
# Vault tooling stays local (Bases, note templates), but the Web Clipper
# templates are tracked — they're the source of truth (see _local/project_docs/web-clipper-pattern.html).
src/_obsidian/*
!src/_obsidian/clipper/

/src/posts/articles/-drafts
# Raw import source texts, not site content
/src/_raw/

# Private LLM wiki — own inner git repo, never in this one (see _local/design/Plan - LLM wiki (private-first).md)
/src/wiki/

# Body images the Obsidian local-images plugin pulls down from a raw wiki clip — third-party
# media that belongs to the source, not to this site. Post clips have empty bodies and have
# never produced one of these; if a post ever genuinely needs one, add it with `git add -f`.
/src/assets/images/*_MD5.*

# Uncompressed audio masters. A field-recording master runs to hundreds of MB (the Nybrostrand
# take is 336 MB), and the repo pattern is the same as for photos: the small derived file ships
# in src/assets/, the original lives on R2. A stray `git add -A` must not be able to pull one in.
*.wav
*.WAV
*.aif
*.aiff
*.flac
*.FLAC

.claude
.omc
.github

# Project notes (kept locally, not in repo)
AGENTS.md
CLAUDE.md
DESIGN.md
IDEAS.md
LOG.md
TODO.md
ROADMAP.md
# AI tool config, kept local (decided 2026-07-31)
.mcp.json


# Netlify dev regenerates this Edge Functions bootstrap lockfile on every run;
# the production build (npm run build -> Eleventy) never uses Deno.
deno.lock
